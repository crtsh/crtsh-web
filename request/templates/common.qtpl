{% import "time" %}

{% func Header(title string) %}
<!DOCTYPE html>
<HTML>
<HEAD>
  <META http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <TITLE>{%s title %}</TITLE>
  <META name="description" content="Free CT Log Certificate Search Tool from Sectigo (formerly Comodo CA)">
  <META name="keywords" content="crt.sh, CT, Certificate Transparency, Certificate Search, SSL Certificate, Sectigo, Comodo CA">
  <LINK href="//fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,700&family=Urbanist:wght@700&family=Roboto+Mono&display=swap" rel="stylesheet">
  <LINK href="/crtsh.css" rel="stylesheet">
</HEAD>
<BODY>
  <DIV class="header">
    <A style="text-decoration:none" href="/"><SPAN class="crtsh">crt.sh</SPAN></A> <SPAN class="title">Certificate Search</SPAN>
  </DIV>
{% endfunc %}

{% func Footer() %}
  <P class="copyright">&copy; <A href="//sectigo.com/">Sectigo</A> Limited 2015-{%d time.Now().Year() %}. All rights reserved.</P>
  <DIV style="display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap">
    <A href="https://sectigo.com/"><IMG src="/sectigo.svg" width="48" height="48"></A>
    <A href="https://github.com/crtsh"><IMG src="/github.svg" width="40" height="40"></A>
  </DIV>
</BODY>
</HTML>
{% endfunc %}
