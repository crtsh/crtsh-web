{% func ErrorPage(seconds int64, plural string, errorMessage string) %}
{%= Header("crt.sh | ERROR!") %}
<BR><BR><BR>

<DIV class="error-message">
Sorry, something went wrong... :-(
<BR><BR>
Your request was terminated by the crt.sh database server after <B>{%dl seconds %}</B> second{%s plural %} with the following messages:
</DIV>
<BR>

<TEXTAREA readonly rows="8" cols="100">{%s errorMessage %}</TEXTAREA>
<BR><BR>

<DIV class="error-message">
Unfortunately, searches that would produce many results may never succeed. For other requests, please try again later.
</DIV>
<BR><BR>

{%= Footer() %}
{% endfunc %}
